# --- Gemini mode ---
# "api_key" = fast to set up, NO BAA, use only with synthetic/test data
# "vertex"  = requires GCP project + BAA, REQUIRED before any real PHI
GEMINI_MODE=api_key

# Required if GEMINI_MODE=api_key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required if GEMINI_MODE=vertex
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Also set GOOGLE_APPLICATION_CREDENTIALS to the path of your service account JSON

GEMINI_MODEL=gemini-2.5-flash

# Frontend origin(s) allowed to call this API, comma-separated
ALLOWED_ORIGINS=http://localhost:5173
